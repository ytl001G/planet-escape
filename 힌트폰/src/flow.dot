digraph G {
 graph [rankdir=TB bgcolor="transparent" nodesep=0.3 ranksep=0.45 fontname="Malgun Gothic" newrank=true];
 node [fontname="Malgun Gothic" fontsize=12 margin="0.26,0.08" penwidth=1.4];
 edge [fontname="Malgun Gothic" fontsize=10 color="#8a8494" fontcolor="#a39eab" arrowsize=0.7 penwidth=1.2];
 "시작전" [label=<<b>시작 전 화면</b><br/><font point-size="10" color="#a39eab">앱을 열면 · 링 자리에 Start · 채팅 · 힌트코드 입력은 써 볼 수 있음 (설명용)</font>> group="spine" shape=box style="rounded,filled" fillcolor="#211e26" color="#4a4452" fontcolor="#ece9f1"];
 "시작" [label=<<b>홈 화면</b><br/><font point-size="10" color="#a39eab">1:45:00 시작 · 가운데 큰 링 타이머(흰색) · 왼쪽 위 채팅 · 아래 힌트코드 입력</font>> group="spine" shape=box style="rounded,filled" fillcolor="#211e26" color="#4a4452" fontcolor="#ece9f1"];
 "안전" [label=<<b>안전 모드 알림</b><br/><font point-size="10" color="#a39eab">방패가 커지며 등장 + 로딩 막대 · 전체 화면</font>> group="spine" shape=box style="rounded,filled" fillcolor="#33213b" color="#cf86e6" fontcolor="#ece9f1"];
 "메인" [label=<<b>메인 화면 (1부)</b><br/><font point-size="10" color="#a39eab">링 보라 · 링 안 진행도(서버 값 · 막대 한 줄 · 지금 부 색) · 오른쪽 위 목표 칸</font>> group="spine" shape=box style="rounded,filled" fillcolor="#33213b" color="#cf86e6" fontcolor="#ece9f1"];
 "g1" [label=<<b>목표: 알렉스의 승인 확보</b><br/><font point-size="10" color="#a39eab">문제 2</font>> group="spine" shape=box style="rounded,filled" fillcolor="#33213b" color="#cf86e6" fontcolor="#ece9f1"];
 "g2" [label=<<b>목표: 오펠리아의 승인 확보</b><br/><font point-size="10" color="#a39eab">문제 3</font>> group="spine" shape=box style="rounded,filled" fillcolor="#33213b" color="#cf86e6" fontcolor="#ece9f1"];
 "g3" [label=<<b>목표: 노아의 승인 확보</b><br/><font point-size="10" color="#a39eab">문제 4</font>> group="spine" shape=box style="rounded,filled" fillcolor="#33213b" color="#cf86e6" fontcolor="#ece9f1"];
 "g4" [label=<<b>목표: 오펠리아 재방문</b><br/><font point-size="10" color="#a39eab">문제 5</font>> group="spine" shape=box style="rounded,filled" fillcolor="#33213b" color="#cf86e6" fontcolor="#ece9f1"];
 "g5" [label=<<b>목표: 에바의 승인 확보</b><br/><font point-size="10" color="#a39eab">문제 6</font>> group="spine" shape=box style="rounded,filled" fillcolor="#33213b" color="#cf86e6" fontcolor="#ece9f1"];
 "g6" [label=<<b>목표: 릴리의 승인</b><br/><font point-size="10" color="#a39eab">문제 7</font>> group="spine" shape=box style="rounded,filled" fillcolor="#33213b" color="#cf86e6" fontcolor="#ece9f1"];
 "전환" [label=<<b>전환부 (ALONE 입력 뒤)</b><br/><font point-size="10" color="#a39eab">보라 그대로 · 진행도 50 고정 · 채팅 · 힌트 입력 못 누름 · 비아 등장 끝까지 이어짐</font>> group="spine" shape=box style="rounded,filled" fillcolor="#33213b" color="#cf86e6" fontcolor="#ece9f1"];
 "비아" [label=<<b>비아 등장</b><br/><font point-size="10" color="#a39eab">보라 → 주황 · 대사 1001</font>> group="spine" shape=box style="rounded,filled" fillcolor="#36261a" color="#ffae4d" fontcolor="#ece9f1"];
 "b1" [label=<<b>비아 안내: 알렉스의 방</b><br/><font point-size="10" color="#a39eab">문제 10 · 대사 1008</font>> group="spine" shape=box style="rounded,filled" fillcolor="#36261a" color="#ffae4d" fontcolor="#ece9f1"];
 "b2" [label=<<b>비아 안내: 오펠리아의 방</b><br/><font point-size="10" color="#a39eab">문제 11 · 대사 1137</font>> group="spine" shape=box style="rounded,filled" fillcolor="#36261a" color="#ffae4d" fontcolor="#ece9f1"];
 "b3" [label=<<b>비아 안내: 노아의 방</b><br/><font point-size="10" color="#a39eab">문제 12 · 대사 1209</font>> group="spine" shape=box style="rounded,filled" fillcolor="#36261a" color="#ffae4d" fontcolor="#ece9f1"];
 "b4" [label=<<b>비아 안내: 에바의 방</b><br/><font point-size="10" color="#a39eab">문제 13 · 대사 1322</font>> group="spine" shape=box style="rounded,filled" fillcolor="#36261a" color="#ffae4d" fontcolor="#ece9f1"];
 "b5" [label=<<b>비아 안내: 릴리의 방</b><br/><font point-size="10" color="#a39eab">문제 14 · 대사 1432</font>> group="spine" shape=box style="rounded,filled" fillcolor="#36261a" color="#ffae4d" fontcolor="#ece9f1"];
 "b6" [label=<<b>비아 정체 공개</b><br/><font point-size="10" color="#a39eab">문제 15 LOVE 입력 뒤</font>> group="spine" shape=box style="rounded,filled" fillcolor="#36261a" color="#ffae4d" fontcolor="#ece9f1"];
 "레버" [label=<<b>레버 선택</b><br/><font point-size="10" color="#a39eab">문제 16 · 폰 화면 변화 없음</font>> group="spine" shape=box style="rounded,filled" fillcolor="#36261a" color="#ffae4d" fontcolor="#ece9f1"];
 "탈출" [label=<<b>탈출 엔딩</b><br/><font point-size="10" color="#a39eab">레버 아래 · 폰 꺼짐</font>> shape=box style="rounded,filled" fillcolor="#211e26" color="#4a4452" fontcolor="#ece9f1"];
 "행성" [label=<<b>행성 엔딩</b><br/><font point-size="10" color="#a39eab">레버 위 · 송출 화면 반복</font>> shape=box style="rounded,filled" fillcolor="#36261a" color="#ffae4d" fontcolor="#ece9f1"];
 "시작전" -> "시작" [label="Start 누름" weight="50"];
