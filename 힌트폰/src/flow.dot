digraph G {
 graph [rankdir=LR bgcolor="transparent" nodesep=0.3 ranksep=0.45 fontname="Malgun Gothic" newrank=true];
 node [fontname="Malgun Gothic" fontsize=12 margin="0.26,0.08" penwidth=1.4];
