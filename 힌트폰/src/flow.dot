 "r16_0" [label=<<b>대기 1 ~ 6</b><br/><font point-size="10" color="#a39eab">같은 코드 넣을 때마다 다음 단계</font>> shape=box style="rounded,filled" fillcolor="#36261a" color="#ffae4d" fontcolor="#ece9f1"];
 "r16_1" [label=<<b>심장 소리</b><br/><font point-size="10" color="#a39eab">6단계 뒤 반복</font>> shape=box style="rounded,filled" fillcolor="#211e26" color="#4a4452" fontcolor="#ece9f1"];
 "r스토리" [label=<<b>스토리 코드</b><br/><font point-size="10" color="#a39eab">스토리코드 앱 · 보너스</font>> shape=box style="rounded,filled" fillcolor="#211e26" color="#4a4452" fontcolor="#ece9f1"];
 "r스토리_0" [label=<<b>패턴 입력</b><br/><font point-size="10" color="#a39eab">오답: 빨간 선 → 초기화</font>> shape=box style="rounded,filled" fillcolor="#211e26" color="#4a4452" fontcolor="#ece9f1"];
 "r스토리_1" [label=<<b>카드 13.5</b><br/><font point-size="10" color="#a39eab">패턴 정답</font>> shape=box style="rounded,filled" fillcolor="#36261a" color="#ffae4d" fontcolor="#ece9f1"];
 "r진행도" [label=<<b>진행도 버튼</b><br/><font point-size="10" color="#a39eab">맞는 코드일 때</font>> shape=box style="rounded,filled" fillcolor="#211e26" color="#4a4452" fontcolor="#ece9f1"];
 "r진행도_0" [label=<<b>% 표시</b><br/><font point-size="10" color="#a39eab">버튼 자리에 · 힌트를 펼쳐도 남음</font>> shape=box style="rounded,filled" fillcolor="#211e26" color="#4a4452" fontcolor="#ece9f1"];
 "채팅" [label=<<b>운영자 채팅</b><br/><font point-size="10" color="#a39eab">위 줄 아래 구분선</font>> shape=box style="rounded,filled" fillcolor="#211e26" color="#4a4452" fontcolor="#ece9f1"];
 "한글kb" [label=<<b>한글 키보드</b><br/><font point-size="10" color="#a39eab">두벌식 · 시프트 · 한/영 · 띄어쓰기</font>> shape=box style="rounded,filled" fillcolor="#211e26" color="#4a4452" fontcolor="#ece9f1"];
 "배너" [label=<<b>알림 배너</b><br/><font point-size="10" color="#a39eab">채팅 밖에서 답장 오면 위에 3.5초</font>> shape=box style="rounded,filled" fillcolor="#211e26" color="#4a4452" fontcolor="#ece9f1"];
 "지도" [label=<<b>지도 팝업</b><br/><font point-size="10" color="#a39eab">1부 · 갈 방만 인물 색 · X · 바깥 · Esc로 닫힘</font>> shape=box style="rounded,filled" fillcolor="#33213b" color="#cf86e6" fontcolor="#ece9f1"];
 "다시보기" [label=<<b>완료 목표 다시 보기</b><br/><font point-size="10" color="#a39eab">1부 · 끝낸 목표 체크</font>> shape=box style="rounded,filled" fillcolor="#33213b" color="#cf86e6" fontcolor="#ece9f1"];
 "어디서든" [label=<<b>어느 화면에서든</b>> shape=box style="rounded,filled" fillcolor="#211e26" color="#4a4452" fontcolor="#ece9f1"];
