 "홈" [label=<<b>홈 · 메인 화면</b><br/><font point-size="10" color="#a39eab">독: 힌트코드 · 채팅 (+ 2부엔 스토리코드)</font>> shape=box style="rounded,filled" fillcolor="#211e26" color="#4a4452" fontcolor="#ece9f1"];
 "힌트앱" [label=<<b>힌트코드 앱</b><br/><font point-size="10" color="#a39eab">위 줄: 뒤로 · 제목 · 알약 타이머</font>> shape=box style="rounded,filled" fillcolor="#211e26" color="#4a4452" fontcolor="#ece9f1"];
 "스토리앱" [label=<<b>스토리코드 앱</b><br/><font point-size="10" color="#a39eab">비아 등장 뒤에만 독에 있음</font>> shape=box style="rounded,filled" fillcolor="#36261a" color="#ffae4d" fontcolor="#ece9f1"];
 "코드kb" [label=<<b>코드 키보드</b><br/><font point-size="10" color="#a39eab">입력 칸 누르면 · 숫자 + 영문 + ⌫</font>> shape=box style="rounded,filled" fillcolor="#211e26" color="#4a4452" fontcolor="#ece9f1"];
 "판별" [label=<<b>코드 판별</b><br/><font point-size="10" color="#a39eab">지금 부와 앱에 맞는 코드만</font>> shape=diamond style="rounded,filled" fillcolor="#211e26" color="#4a4452" fontcolor="#ece9f1"];
 "r없는" [label=<<b>없는 코드</b>> shape=box style="rounded,filled" fillcolor="#211e26" color="#4a4452" fontcolor="#ece9f1"];
 "r없는_0" [label=<<b>반응 없음</b><br/><font point-size="10" color="#a39eab">펼쳐 둔 앞 코드 힌트만 걷힘</font>> shape=box style="rounded,filled" fillcolor="#211e26" color="#4a4452" fontcolor="#ece9f1"];
 "r1부" [label=<<b>1부 코드</b><br/><font point-size="10" color="#a39eab">비아 등장 전 문제</font>> shape=box style="rounded,filled" fillcolor="#211e26" color="#4a4452" fontcolor="#ece9f1"];
 "r1부_0" [label=<<b>힌트 1</b><br/><font point-size="10" color="#a39eab">버튼 줄 아래로 펼침</font>> shape=box style="rounded,filled" fillcolor="#33213b" color="#cf86e6" fontcolor="#ece9f1"];
 "r1부_1" [label=<<b>힌트 2</b>> shape=box style="rounded,filled" fillcolor="#33213b" color="#cf86e6" fontcolor="#ece9f1"];
 "r1부_2" [label=<<b>힌트 3</b>> shape=box style="rounded,filled" fillcolor="#33213b" color="#cf86e6" fontcolor="#ece9f1"];
 "r1부_3" [label=<<b>정답</b>> shape=box style="rounded,filled" fillcolor="#d9d4e0" color="#d9d4e0" fontcolor="#17151b"];
 "r2부전" [label=<<b>2부 코드 (비아 등장 전)</b>> shape=box style="rounded,filled" fillcolor="#211e26" color="#4a4452" fontcolor="#ece9f1"];
 "r2부전_0" [label=<<b>반응 없음</b><br/><font point-size="10" color="#a39eab">1부엔 비아 힌트 없음</font>> shape=box style="rounded,filled" fillcolor="#211e26" color="#4a4452" fontcolor="#ece9f1"];
 "r2부" [label=<<b>2부 코드</b><br/><font point-size="10" color="#a39eab">비아 등장 후 · 문제 10 ~ 15</font>> shape=box style="rounded,filled" fillcolor="#211e26" color="#4a4452" fontcolor="#ece9f1"];
 "r2부_0" [label=<<b>힌트 1</b><br/><font point-size="10" color="#a39eab">버튼 줄 아래로 펼침</font>> shape=box style="rounded,filled" fillcolor="#36261a" color="#ffae4d" fontcolor="#ece9f1"];
