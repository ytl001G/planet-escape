 "행성" [label=<<b>행성 엔딩</b><br/><font point-size="10" color="#a39eab">레버 위 · 송출 화면 반복</font>> shape=box style="rounded,filled" fillcolor="#36261a" color="#ffae4d" fontcolor="#ece9f1"];
